# ---------------------------------------------------------------------------
# Nextcloud private cloud -- environment contract
#
#   cp .env.example .env
#   ./scripts/gen-secrets.sh
#
# Every value marked REQUIRED has no default. Compose fails loudly on a
# missing required value rather than silently starting with a weak one.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=nextcloud

# --- Image pins ------------------------------------------------------------
# See docs/adr/002-version-and-release-channel.md for why the newest stable
# Nextcloud is used here, unlike the Odoo project in this portfolio which
# deliberately trails by one major.
NEXTCLOUD_VERSION=34.0.3-fpm-alpine
MARIADB_VERSION=11.8.9-noble
REDIS_VERSION=8.8.2-alpine3.23
NGINX_VERSION=1.31.4-alpine3.24

# --- Database --------------------------------------------------------------
# MariaDB rather than PostgreSQL: docs/adr/003-database-selection.md.
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=                        # REQUIRED
MYSQL_ROOT_PASSWORD=                   # REQUIRED

# MariaDB memory tuning lives in config/mariadb/my.cnf, not here -- one source
# of truth avoids the failure mode where an env var and a config file disagree
# and the file quietly wins. See docs/architecture/capacity-planning.md.

# --- Redis -----------------------------------------------------------------
# Redis is NOT optional for a multi-user Nextcloud. It provides transactional
# file locking; without it, concurrent access to the same file produces
# "file is locked" errors that look like corruption and are not.
REDIS_PASSWORD=                        # REQUIRED

# --- Nextcloud -------------------------------------------------------------
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=              # REQUIRED

# Hostnames Nextcloud will answer for. A request with a Host header not in
# this list is refused -- this is Nextcloud's defence against host-header
# poisoning of generated links (password reset emails, share URLs).
# Quoted: shell scripts here `source .env`, and an unquoted value containing
# a space is parsed as a command. Compose tolerates it; bash does not.
NEXTCLOUD_TRUSTED_DOMAINS="nextcloud.localhost localhost"

# CIDR of the reverse proxy. Nextcloud reads the client address from
# X-Forwarded-For ONLY from an address in this list. Set too broadly, any
# client can spoof its own IP and defeat brute-force protection.
NEXTCLOUD_TRUSTED_PROXIES=172.16.0.0/12

# Generated share and email links use this. Wrong, and password-reset links
# point somewhere users cannot reach.
NEXTCLOUD_OVERWRITE_PROTOCOL=https
NEXTCLOUD_OVERWRITE_CLI_URL=https://nextcloud.localhost:8443

# Default per-user quota. "none" means unlimited, which on a shared filesystem
# means one user can fill the disk for everyone.
NEXTCLOUD_DEFAULT_QUOTA="10 GB"

# --- PHP -------------------------------------------------------------------
# Upload ceiling. Must agree with client_max_body_size in nginx -- if nginx is
# smaller, the user sees a 413 with no useful message; if PHP is smaller, the
# upload transfers fully and is then rejected, which is worse.
PHP_UPLOAD_LIMIT=10G
PHP_MEMORY_LIMIT=1024M

# Worker sizing. pm.max_children x per-process memory must fit the container
# limit -- the arithmetic is in docs/architecture/capacity-planning.md.
PHP_FPM_MAX_CHILDREN=32
PHP_FPM_START_SERVERS=8
PHP_FPM_MIN_SPARE_SERVERS=4
PHP_FPM_MAX_SPARE_SERVERS=12

# --- HTTP / TLS ------------------------------------------------------------
NEXTCLOUD_DOMAIN=nextcloud.localhost
HTTP_PORT=8081
HTTPS_PORT=8444
BIND_ADDRESS=127.0.0.1

# --- Object storage (optional) ---------------------------------------------
# Leave OBJECTSTORE_S3_BUCKET empty to keep files on the local volume.
#
# Setting these makes S3 the PRIMARY storage: Nextcloud writes file content to
# the bucket and keeps only metadata in the database. This is not a backup
# target and not a mount -- it changes where user data lives.
#
# It CANNOT be switched on for an existing instance with data already stored
# locally without a migration. See docs/adr/005-object-storage.md.
OBJECTSTORE_S3_BUCKET=
OBJECTSTORE_S3_REGION=
OBJECTSTORE_S3_HOST=
OBJECTSTORE_S3_KEY=
OBJECTSTORE_S3_SECRET=
OBJECTSTORE_S3_SSL=true
OBJECTSTORE_S3_USEPATH_STYLE=false

# --- Backups ---------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6

# age recipient (public key) for encryption at rest. Backups here contain
# every user's files. Leave blank only for local testing.
BACKUP_AGE_RECIPIENT=

# --- Observability ---------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=                # REQUIRED when observability runs
GRAFANA_PORT=3002
PROMETHEUS_PORT=9092
PROMETHEUS_RETENTION=15d

# Nextcloud's serverinfo app exposes metrics at /ocs/v2.php/apps/serverinfo/api/v1/info
# behind a token. Generated by scripts/gen-secrets.sh and applied by
# scripts/occ.sh during setup.
NEXTCLOUD_METRICS_TOKEN=

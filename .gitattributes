# Normalise to LF in the repository. Scripts in this tree are executed inside
# Linux containers and by Ansible on Linux hosts; a CRLF shebang line produces
# the notoriously unhelpful "bad interpreter: no such file or directory".
* text=auto eol=lf

*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.conf    text eol=lf
Makefile  text eol=lf
Dockerfile text eol=lf

*.png binary
*.jpg binary
*.gz  binary
*.dump binary

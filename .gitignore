# Secrets -- never commit. Only *.example files belong in version control.
.env
.env.*
!.env.example
!.env.*.example
# Both forms. `secrets/` matches only a directory, so `git check-ignore
# secrets` reports it as un-ignored until the directory actually exists --
# which makes a pre-commit audit look like it found a problem.
secrets
secrets/
*.pem
*.key
!config/nginx/tls/.gitkeep

# Locally generated TLS material (scripts/gen-local-tls.sh)
config/nginx/tls/*
!config/nginx/tls/.gitkeep

# Backup artefacts -- these contain user files and are large
backups/
*.dump
*.sql
*.tar.gz
*.tar.zst

# Test fixtures generated at run time
tests/.tmp/

# Terraform
infrastructure/terraform/.terraform/
infrastructure/terraform/*.tfstate
infrastructure/terraform/*.tfstate.*
infrastructure/terraform/*.tfvars
!infrastructure/terraform/*.tfvars.example
infrastructure/terraform/.terraform.lock.hcl.bak
infrastructure/terraform/backend.hcl

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Rendered from .env by scripts/gen-secrets.sh; contains a live password.
monitoring/mysqld-exporter/my.cnf

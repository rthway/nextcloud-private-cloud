# ---------------------------------------------------------------------------
# MariaDB configuration for a Nextcloud workload.
#
# Mounted at /etc/mysql/conf.d/99-nextcloud.cnf. The 99- prefix makes it win
# over the image's own defaults.
#
# Sized for the reference host in docs/architecture/capacity-planning.md:
# 4 vCPU / 8 GB, with the db container capped at 2 GB in compose.yml. Every
# memory number is derived from that 2 GB, NOT from host RAM.
#
# Nextcloud's access pattern is what shapes this: overwhelmingly small
# indexed reads against oc_filecache (which is by far the largest table),
# short write transactions on upload, and occasional large scans during
# `occ files:scan`. It is read-dominated, which is why the buffer pool matters
# more than anything else here.
# ---------------------------------------------------------------------------

[mysqld]

# --- Character set ---------------------------------------------------------
# utf8mb4, not utf8. MariaDB's "utf8" is three-byte and cannot store emoji or
# many CJK characters -- a user creating a folder with an emoji in the name
# gets an incomprehensible error. Nextcloud checks for this and warns.
character-set-server = utf8mb4
collation-server = utf8mb4_general_ci

# Required for utf8mb4 indexes on older row formats. DYNAMIC is the modern
# default and supports the longer index prefix Nextcloud's schema needs.
innodb_default_row_format = dynamic

# --- InnoDB buffer pool ----------------------------------------------------
# The single most important setting. Nextcloud is read-heavy against
# oc_filecache; if that table's hot pages fit here, queries are memory-fast.
#
# 1 GB is 50% of the 2 GB container limit. The usual "70-80% of RAM" advice
# assumes a dedicated database server -- inside a container it must leave room
# for connections, sort buffers and the server's own overhead, or the OOM
# killer takes the database.
innodb_buffer_pool_size = 1G
innodb_buffer_pool_instances = 1

# --- InnoDB durability -----------------------------------------------------
# flush_log_at_trx_commit = 1 is full ACID: every commit is fsynced.
#
# Setting 2 is a real throughput win and a real way to lose up to a second of
# committed transactions on power loss. For a file-sync server that means the
# database forgetting files that exist on disk -- Nextcloud then treats them
# as unknown and the recovery is a full `occ files:scan`. Not a trade worth
# making.
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT

# Larger redo log means fewer checkpoint flushes. Nextcloud's upload bursts
# dirty pages quickly; a small log turns that into an IO stall users feel.
innodb_log_file_size = 256M
innodb_log_buffer_size = 16M

# SSD assumptions. The defaults encode spinning rust and make InnoDB
# needlessly conservative about background IO.
innodb_io_capacity = 2000
innodb_io_capacity_max = 4000
innodb_flush_neighbors = 0
innodb_read_io_threads = 4
innodb_write_io_threads = 4

# One file per table. Without it, dropping a table returns space to a single
# shared tablespace that never shrinks -- so disk usage only ever grows.
innodb_file_per_table = 1

# --- Connections -----------------------------------------------------------
# Budget, cross-checked against PHP-FPM in capacity-planning.md:
#   app pool   32 workers x 1 connection   = 32
#   cron                                   =  4
#   exporter                               =  3
#   operator / backup                      =  5
#                                            --
#                                            44, inside 100
#
# Each connection costs memory. Raising this without raising the container
# memory limit converts a connection error into an OOM kill.
max_connections = 100

# Nextcloud's WebDAV clients hold connections open between operations. The
# 28800s default keeps dead ones for eight hours; 600s reclaims them while
# staying well above any legitimate idle gap.
wait_timeout = 600
interactive_timeout = 600

# --- Per-connection buffers ------------------------------------------------
# These are allocated PER CONNECTION when used, so the worst case is the value
# times max_connections. Kept modest for exactly that reason.
sort_buffer_size = 2M
read_buffer_size = 1M
read_rnd_buffer_size = 1M
join_buffer_size = 2M

# Nextcloud stores file metadata and share information in rows that can be
# large. 64 MB accommodates them without inviting a single query to allocate
# something enormous.
max_allowed_packet = 64M

# --- Table cache -----------------------------------------------------------
# Nextcloud's schema has many tables and its apps add more.
table_open_cache = 4000
table_definition_cache = 2000

# --- Temporary tables ------------------------------------------------------
# Queries exceeding these spill to disk, which is orders of magnitude slower.
# `occ files:scan` and large share listings are the ones that hit it.
tmp_table_size = 64M
max_heap_table_size = 64M

# --- Binary logging --------------------------------------------------------
# Enabled on the command line in compose.yml (log-bin, ROW format), because
# those must be set before this file is read.
#
# ROW format is not optional: Nextcloud generates non-deterministic statements
# that STATEMENT-based replication reproduces incorrectly, silently diverging
# a replica or a point-in-time restore from the original.
sync_binlog = 1
binlog_cache_size = 1M

# --- Logging ---------------------------------------------------------------
# To stderr, so the container runtime owns collection and rotation.
log_error = /dev/stderr

# Every statement over 1s, plus those not using an index. The second is what
# catches a missing index after an upgrade -- Nextcloud ships
# `occ db:add-missing-indices` precisely because this happens.
slow_query_log = 1
slow_query_log_file = /dev/stderr
long_query_time = 1
log_queries_not_using_indexes = 1
log_slow_rate_limit = 100

# --- Safety ----------------------------------------------------------------
# STRICT_TRANS_TABLES makes silent truncation an error. Without it, a value
# too long for its column is quietly cut short -- which for a file path means
# a file Nextcloud can never find again.
sql_mode = STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION

# Symbolic links off: a symlinked table definition can point outside the data
# directory.
symbolic-links = 0

# Do not resolve client hostnames. It adds a DNS round trip to every
# connection and, when DNS is slow, presents as random connection latency.
skip-name-resolve

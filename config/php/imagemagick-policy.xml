<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policymap [
  <!ELEMENT policymap (policy)*>
  <!ATTLIST policymap xmlns CDATA #FIXED ''>
  <!ELEMENT policy EMPTY>
  <!ATTLIST policy xmlns CDATA #FIXED '' domain NAMES #REQUIRED
    name NMTOKEN #IMPLIED pattern CDATA #IMPLIED rights NMTOKEN #IMPLIED
    stealth NMTOKEN #IMPLIED value CDATA #IMPLIED>
]>
<!--
  ImageMagick security policy.

  ImageMagick has a long history of vulnerabilities in coders for formats
  nobody needs on a file-sync server -- the ImageTragick family being the
  best known. It is used here only to generate thumbnails for images and
  PDFs, so everything else is denied.

  This is a deny-by-exception list: the coders Nextcloud actually needs are
  left alone and the historically dangerous ones are removed. Nextcloud's own
  preview provider list in zz-managed.config.php is the second layer.
-->
<policymap>
  <!-- Resource ceilings. A crafted image that decompresses to an enormous
       bitmap is a denial-of-service vector; these bound it. -->
  <policy domain="resource" name="memory" value="256MiB"/>
  <policy domain="resource" name="map" value="512MiB"/>
  <policy domain="resource" name="width" value="16KP"/>
  <policy domain="resource" name="height" value="16KP"/>
  <policy domain="resource" name="area" value="128MB"/>
  <policy domain="resource" name="disk" value="1GiB"/>
  <policy domain="resource" name="time" value="120"/>

  <!-- Coders with a history of remote code execution or SSRF. None are
       needed to thumbnail a photograph. -->
  <policy domain="coder" rights="none" pattern="EPHEMERAL"/>
  <policy domain="coder" rights="none" pattern="URL"/>
  <policy domain="coder" rights="none" pattern="HTTPS"/>
  <policy domain="coder" rights="none" pattern="HTTP"/>
  <policy domain="coder" rights="none" pattern="MVG"/>
  <policy domain="coder" rights="none" pattern="MSL"/>
  <policy domain="coder" rights="none" pattern="TEXT"/>
  <policy domain="coder" rights="none" pattern="SHOW"/>
  <policy domain="coder" rights="none" pattern="WIN"/>
  <policy domain="coder" rights="none" pattern="PLT"/>
  <policy domain="coder" rights="none" pattern="XPS"/>

  <!-- PDF and PS go through Ghostscript, which has had its own share.
       Read-only, and only because PDF previews are genuinely wanted. -->
  <policy domain="coder" rights="read" pattern="PDF"/>
  <policy domain="coder" rights="none" pattern="PS"/>
  <policy domain="coder" rights="none" pattern="PS2"/>
  <policy domain="coder" rights="none" pattern="PS3"/>
  <policy domain="coder" rights="none" pattern="EPS"/>

  <!-- Block indirect reads (@file syntax), which turn a filename into an
       arbitrary file read. -->
  <policy domain="path" rights="none" pattern="@*"/>
</policymap>

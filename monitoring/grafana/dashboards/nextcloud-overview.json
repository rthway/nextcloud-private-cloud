    {
      "type": "timeseries",
      "title": "Responses by status (from logs)",
      "description": "Derived from the nginx JSON access log in Loki, not from stub_status. Open-source nginx exposes no per-status-code metric -- that is an nginx Plus feature -- so this is the honest source for an error-rate view, and it is why there is no Prometheus alert on 5xx rate.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 34
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "refId": "A",
          "queryType": "range",
          "expr": "sum by (status) (count_over_time({service=\"proxy\"} | json | __error__=`` [$__auto]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {}
    },
